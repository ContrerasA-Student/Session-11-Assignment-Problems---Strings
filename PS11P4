# Input
Text = input("Enter a Line of Text: ")
LineLength = int(input("Enter Number of Characters per Line: "))
NumberOfLines = int(input("Enter Number of Lines to Print: "))
Direction = input("Enter Scroll Direction (Left or Right): ").lower()

# Process
BaseText = (Text * ((LineLength // len(Text)) + 2))[:LineLength]

# Output
current = BaseText

for i in range(NumberOfLines):
    print(current)
    if Direction == "Left":
        current = current[1:] + current[0]
    elif Direction == "Right":
        current = current[-1] + current[:-1]
